PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/teamsync?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret
ENABLE_DEMO_MODE=false # Set to true for local recruiter demo testing, false for strict production deploy
